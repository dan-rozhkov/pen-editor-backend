node_modules/
dist/
.env
.env.*
!.env.example
*.tsbuildinfo
.logs/

# Vitest coverage output
coverage/

# Generated trace-analysis reports
reports/

# Agent-isolated implementation worktrees
.worktrees/

# Subagent-driven-development scratch: per-plan ledgers, task briefs, reports
# and review packages. The git history is the durable record; this is the
# controller's working memory while a plan is being executed.
.superpowers/

# Hand-authored showcase runs staged by an agent. The skills tell those agents
# to work in a scratchpad outside the repo; this is the backstop for when one
# does not, so a stray run cannot end up committed or clutter someone else's
# `git status`.
.handrun/
scratchpad/

# Per-run flaky-test record from scripts/flakyReporter.ts, consumed by
# scripts/flaky-summary.mjs in CI. Only written when a test actually needed
# a retry — a normal run leaves no file at all.
flaky-tests.json

# StrykerJS sandbox: temporary copies of the source tree it mutates and
# test-runs against (--tempDirName default) — NOT the incremental-run
# cache. The incremental cache is reports/stryker-incremental.json,
# already covered by reports/ above.
.stryker-tmp/
