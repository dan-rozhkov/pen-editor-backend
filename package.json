{
  "name": "pen-editor-backend",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc && rm -rf dist/skills && cp -R src/skills dist/skills",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.23",
    "@aws-sdk/client-s3": "^3.1018.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.85",
    "fastify": "^5.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
