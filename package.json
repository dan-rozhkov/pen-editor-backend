{
  "name": "pen-editor-backend",
  "version": "0.25.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "analyze": "tsx --env-file=.env src/analysis/run.ts",
    "analyze:dist": "node --env-file=.env dist/analysis/run.js",
    "build": "tsc && rm -rf dist/skills && cp -R src/skills dist/skills && rm -rf dist/analysis/migrations && cp -R src/analysis/migrations dist/analysis/migrations",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "check:dup": "jscpd src"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.23",
    "@aws-sdk/client-s3": "^3.1018.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "ai": "^6.0.85",
    "fastify": "^5.2.0",
    "pg": "^8.22.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jscpd": "^5.0.12",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "ws": "^8.21.1"
  }
}
