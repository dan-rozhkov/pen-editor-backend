PORT=3001
HOST=0.0.0.0

# DeepSeek (required) — the chat agent talks to DeepSeek directly, not through
# OpenRouter. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# OpenRouter (required) — NOT used for the chat model. Still required for
# vision (VISION_MODEL), analysis (ANALYSIS_MODEL), image generation
# (OPENROUTER_IMAGE_MODEL) and the showcase's default model.
OPENROUTER_API_KEY=sk-or-...
# The single model the design agent runs on. There is no per-request model
# choice: clients cannot pick a model, so whatever is set here is what every
# user gets. Served to the frontend via GET /api/models (without its provider
# prefix — see CLAUDE.md's "Chat model provider" section).
#
# Provider is chosen by an explicit "<provider>:" prefix, matched against a
# two-name allowlist in src/ai/provider.ts — NOT a blind split(":"), because
# OpenRouter ids themselves contain colons (openai/gpt-4o:extended). An id
# with no recognized prefix is treated as a bare OpenRouter id (legacy path,
# so already-deployed values and `showcase:generate --model=` keep working).
CHAT_MODEL=deepseek:deepseek-flash
# How hard the model "thinks" before replying, for model families that
# support reasoning control (see REASONING_MODEL_PREFIXES in
# src/ai/provider.ts). That allowlist only matters when CHAT_MODEL points at
# OpenRouter — "deepseek-flash" (the default above) is NOT in it and doesn't
# need to be: the DeepSeek-direct branch always sends an explicit `thinking`
# value regardless of REASONING_MODEL_PREFIXES (see mapReasoningEffort in
# provider.ts). test/provider-routing.test.ts's "default CHAT_MODEL
# reasoning coverage gate" asserts whichever branch the shipped default
# resolves to actually suppresses reasoning, so a future default change
# fails CI instead of silently reintroducing always-on reasoning.
# One of xhigh|high|medium|low|minimal|none. Default "none": for the
# previous default model (deepseek/* on OpenRouter), it was the only value
# that actually suppressed reasoning — "minimal"/"low"/.../"high" and
# reasoning.max_tokens were all measured to be ignored, pinned at the
# reasoning-token budget ceiling either way.
#
# For the current default (DeepSeek direct), this six-way scale is
# compressed to the three efforts @ai-sdk/deepseek actually accepts
# (low|high|max): none → thinking.disabled; minimal/low → low; medium/high
# → high; xhigh → max. @ai-sdk/deepseek defaults `thinking` to `enabled`
# when omitted, so createModel always sends an explicit `thinking` value —
# leaving providerOptions empty silently brings back always-on reasoning.
#
# Raise this if CHAT_MODEL points at an OpenRouter family where gradations
# work (see REASONING_MODEL_PREFIXES).
CHAT_REASONING_EFFORT=none

# Comma-separated origins allowed by CORS.
# Empty = allow any origin (local development only — set this in production!)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dump full agent session traces to .logs/
ENABLE_AGENT_LOGGING=false

# Research mode (optional) — enables the Refero MCP toolset
REFERO_API_KEY=

# GitHub access (optional) — powers read_design_repo/read_repo_files (the
# agent reads a real repo's tokens/components). Unset = public repos only,
# capped at GitHub's ~60 unauthenticated requests/hour. Set a personal
# access token to raise that to 5000/hour.
#
# SECURITY: the /api/repo/* routes are unauthenticated. By default, EVERY
# repo read through them (even with a token set below) is preceded by an
# unauthenticated visibility check, so a token with `repo` scope can raise
# your rate limit without turning this into an open proxy onto your private
# repos for anyone who can reach this server. Only flip
# GITHUB_ALLOW_PRIVATE_REPOS below if you are self-hosting this alone and
# deliberately want the agent to read your own private repos too — doing so
# on a shared/public deployment lets any caller read anything the token
# owner can see.
GITHUB_TOKEN=
# Default false = public repos only, regardless of GITHUB_TOKEN. See the
# warning above before setting this to true.
GITHUB_ALLOW_PRIVATE_REPOS=false

# Internet search (optional) — enables web_search/fetch_url tools (Tavily).
# Free tier: 1,000 credits/month. Get a key at https://app.tavily.com
TAVILY_API_KEY=

# Image upload (optional) — all four S3_* vars below are required to enable it
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
# Where the public reads those objects. Leave empty for path-style providers
# (timeweb), which serve them straight off S3_ENDPOINT/S3_BUCKET. Cloudflare R2
# splits the two — set this to the bucket's r2.dev subdomain or custom domain,
# with no bucket segment: https://pub-<hash>.r2.dev
S3_PUBLIC_BASE_URL=
# Canned ACL per uploaded object. Timeweb needs public-read; R2 has no object
# ACLs and rejects the header — set this EMPTY on R2 or every upload fails.
S3_OBJECT_ACL=public-read
# Comma-separated bases we no longer upload to but must still read. After a
# provider migration, already-published showcase HTML still points its <img>
# tags at the old host, and /api/image-proxy only proxies allowlisted prefixes
# (the buckets have no CORS) — omit this and the back catalogue loses its
# images. Both timeweb spellings (.com/.cloud) are covered automatically.
S3_LEGACY_PUBLIC_BASE_URLS=

# Model used by generateObject() calls that need a real json_schema response
# format (POST /api/user-skills/generate, prototype-link screen matching).
# @ai-sdk/deepseek never sets supportsStructuredOutputs, so a DeepSeek-direct
# model here would silently degrade response_format to {type:"json_object"}
# and push the schema into a system message instead — much likelier to drift
# out of shape and throw generateObject's NoObjectGeneratedError. Defaults to
# the OpenRouter model these two call sites already ran on before CHAT_MODEL
# moved to DeepSeek-direct; stays on OpenRouter regardless of CHAT_MODEL.
STRUCTURED_MODEL=openrouter:deepseek/deepseek-v4.1-flash

# --- Trace analysis (optional) ---
# Postgres for agent traces (Aiven free tier). Append ?sslmode=no-verify for Aiven.
TRACE_DATABASE_URL=
# Days to keep raw (unsanitized) traces before the analyze worker deletes them.
TRACE_RAW_TTL_DAYS=14
# Cheap model used by the analysis worker for summarization/clustering.
# Stays on OpenRouter (unaffected by the DeepSeek-direct chat model above).
ANALYSIS_MODEL=openrouter:google/gemini-2.5-flash
# Optional: Gemini API key for summary embeddings (skipped when empty).
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-004

# --- Self-improvement loop (optional, needs TRACE_DATABASE_URL above) ---
# Phase 1: per-user persistent memory (snapshot injection + `memory` tool +
# background review). Off until verified live. See CLAUDE.md's "Persistent
# agent memory" section.
MEMORY_ENABLED=false
# Phase 2: lets the agent write its own skills into agent_skills. Off until
# verified live. See CLAUDE.md's "Self-authored skills" section.
SELF_SKILLS_ENABLED=false

# --- Vision (optional auxiliary vision model for analyze_image / describing
# images and screenshots to text-only main models) ---
# Empty/whitespace = vision off. Stays on OpenRouter (unaffected by the
# DeepSeek-direct chat model above).
VISION_MODEL=openrouter:google/gemini-2.5-flash
# Cap on the vision model's output length.
VISION_MAX_TOKENS=1200
# Timeout for a single vision request.
VISION_TIMEOUT_MS=120000

# --- MCP server (optional) ---
# Exposes /api/mcp (streamable HTTP, for Claude Code/claude.ai/Cursor) and
# /api/mcp/ws (browser tab bridge).
#
# Unset behavior depends on NODE_ENV (see src/mcp/autoToken.ts):
#   - Non-production (the default for `npm run dev`): auto-token mode. A
#     per-process token is generated (or reused across a same-port restart),
#     every request is restricted to loopback (127.0.0.1) callers, and
#     {url, token, port} is published to ~/.pen-editor/mcp.json so
#     pen-editor/pen-editor-plugin can connect with zero config. No action
#     needed here for local dev.
#   - Production (NODE_ENV=production): /api/mcp* returns 503 (feature off)
#     unless you set an explicit token below — auto-token mode never
#     activates in production, since its loopback check doesn't hold behind
#     a same-host reverse proxy.
#
# Set this to enable MCP from a non-loopback client, or in production.
# Generate a strong random value, e.g. `openssl rand -hex 24`.
MCP_AUTH_TOKEN=

# --- Product analytics (optional, PostHog) ---
# Empty key = analytics fully disabled (no-op client, no network calls, no
# posthog-node instance). See CLAUDE.md's "Analytics" section for the events
# captured and the no-PII rule.
# POSTHOG_HOST must match the region your PostHog project lives in — the
# wrong region answers 200 to an unknown key and drops every event silently.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- fal.ai image ops (optional) ---
# Background removal (remove_background) and vectorization (vectorize_image).
# Without FAL_KEY the feature is fully off: /api/remove-background and
# /api/vectorize return 503, GET /api/models reports imageOps as false, and
# both tools are dropped from the agent's tool set.
FAL_KEY=
FAL_BG_MODEL=smoretalk-ai/rembg-enhance
FAL_VECTORIZE_MODEL=fal-ai/recraft/vectorize
# Deadline covering the whole operation: the fal.run call, downloading its
# result, and (if S3 is configured) re-uploading it to our bucket.
FAL_TIMEOUT_MS=60000
