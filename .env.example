PORT=3001
HOST=0.0.0.0

# OpenRouter (required)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional. The built-in model list (config.ts DEFAULT_MODELS) and OPENROUTER_MODEL
# are always allowed and served to the frontend via GET /api/models. Set this only
# to allow EXTRA models beyond the built-in list (comma-separated).
# OPENROUTER_ALLOWED_MODELS=

# Comma-separated origins allowed by CORS.
# Empty = allow any origin (local development only — set this in production!)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dump full agent session traces to .logs/
ENABLE_AGENT_LOGGING=false

# Research mode (optional) — enables the Refero MCP toolset
REFERO_API_KEY=

# Image upload (optional) — all four S3_* vars below are required to enable it
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-1
