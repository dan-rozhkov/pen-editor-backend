{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "enabledManagers": [
    "npm"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "@sideform/browser-agent"
      ],
      "enabled": true,
      "labels": [
        "browser-agent"
      ],
      "schedule": [
        "at any time"
      ],
      "automerge": false,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": false
    },
    {
      "matchDepNames": [
        "@sideform/browser-agent"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
